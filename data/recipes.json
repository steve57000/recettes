      "steps": [
        {
          "id": "step-7lka0ld",
          "text": "Avant de commencer mettre une poignée de boulghour dans un bol d'eau pendant 15 mn et laisser ramollir."
        },
        {
          "id": "step-msju49k",
          "text": "Rincez les herbes et ciselez-les."
        },
        {
          "id": "step-6chgo07",
          "text": "Lavez les tomates et épluchez le concombre puis coupez-les en petits cubes."
        },
        {
          "id": "step-23tvb5o",
          "text": "Épluchez l’oignon et coupez-le en petits dés très fin."
        },
        {
          "id": "step-kolz2ni",
          "text": "Dans un grand saladier, mélangez tous les ingrédients."
        },
        {
          "id": "step-a7osowf",
          "text": "Lorsque le boulghour ne croque plus, le sortir de l'eau, et le presser entre les mains pour l'essorer. Le mettre dans le saladier avec le reste."
        },
        {
          "id": "step-zso385o",
          "text": "Assaisonnez ensuite avec le jus d'un citron, le cumin, l’huile d’olive, le sel et le poivre. Mélangez bien et réservez au frais."
        }
      ],
